{
  "project": "MaskProj",
  "project_desc": "bitmask / 2d layout / events / record layout golden sample (B-2/B-4/B-9)",
  "modules": [
    {
      "name": "MASK_ECU",
      "comment": "masks, 2d matrix, event channel, value layout",
      "mod_common": true,
      "mod_par": true,
      "record_layouts": [
        {"name": "RL_VALUE", "attributes": ["FNC_VALUES 0 UWORD ROW_DIR DIRECT"]},
        {"name": "RL_CURVE_AXIS", "attributes": ["FNC_VALUES 0 UWORD ROW_DIR DIRECT",
                                                  "AXIS_PTS_X 2 UWORD INDEX_INCR DIRECT"]},
        {"name": "RL_COMPLEX", "attributes": ["FNC_VALUES 0 UWORD ROW_DIR DIRECT",
                                              "RESERVED 1 UWORD"]}
      ],
      "compu_methods": [
        {"name": "CM_IDENT", "type": "IDENTICAL"}
      ],
      "measurements": [
        {"name": "M_MASK", "desc": "连续位掩码 UWORD", "datatype": "UWORD",
         "compu": "CM_IDENT", "address": "0x3000", "ext": "0x0",
         "bit_mask": "0x0F00", "sample_raw_int": 15},
        {"name": "M_BADMASK", "desc": "non-contiguous mask", "datatype": "UWORD",
         "compu": "CM_IDENT", "address": "0x3002", "ext": "0x0",
         "bit_mask": "0x0F0F"},
        {"name": "M_2D", "desc": "2x3 UWORD regular matrix", "datatype": "UWORD",
         "compu": "CM_IDENT", "address": "0x3010", "ext": "0x12",
         "matrix_dim": [2, 3], "layout": "ROW_DIR", "read_write": false},
        {"name": "M_UBYTE", "desc": "1-byte element for AG unaligned",
         "datatype": "UBYTE", "compu": "CM_IDENT", "address": "0x3020",
         "ext": "0x0"},
        {"name": "M_ARR8", "desc": "8-byte array for AG element counting",
         "datatype": "UBYTE", "compu": "CM_IDENT", "address": "0x3048",
         "ext": "0x0", "array_size": 8, "read_write": false},
        {"name": "M_U64", "desc": "8-byte element for AG counting",
         "datatype": "A_UINT64", "compu": "CM_IDENT", "address": "0x3030",
         "ext": "0x0"},
        {"name": "M_U64MAX", "desc": "uint64 max precision (B-14)",
         "datatype": "A_UINT64", "compu": "CM_IDENT", "address": "0x3038",
         "ext": "0x0"},
        {"name": "M_I64MIN", "desc": "int64 min precision (B-14)",
         "datatype": "A_INT64", "compu": "CM_IDENT", "address": "0x3040",
         "ext": "0x0"}
      ],
      "characteristics": [
        {"name": "C_VALUE", "desc": "VALUE with RECORD_LAYOUT inference",
         "ctype": "VALUE", "address": "0x3100", "deposit": "RL_VALUE",
         "compu": "CM_IDENT", "upper": 65535, "ext": "0x12"},
        {"name": "C_CURVE", "desc": "curve is metadata only", "ctype": "CURVE",
         "address": "0x3200", "deposit": "RL_VALUE", "compu": "CM_IDENT",
         "upper": 65535},
        {"name": "C_VALBLK", "desc": "VAL_BLK 无 MATRIX_DIM → 元素数不可证",
         "ctype": "VAL_BLK", "address": "0x3300", "deposit": "RL_VALUE",
         "compu": "CM_IDENT", "upper": 65535},
        {"name": "C_VALBLK_EXEC", "desc": "连续 UWORD×4（元素类型与元素数皆可证）",
         "ctype": "VAL_BLK", "address": "0x3700", "deposit": "RL_VALUE",
         "compu": "CM_IDENT", "upper": 65535, "matrix_dim": [4]},
        {"name": "C_CURVE_AXIS", "desc": "版式含 AXIS_PTS_X → 判定器拒绝",
         "ctype": "CURVE", "address": "0x3800", "deposit": "RL_CURVE_AXIS",
         "compu": "CM_IDENT", "upper": 65535},
        {"name": "C_COMPLEX_RL", "desc": "版式含 RESERVE → 复合布局拒绝",
         "ctype": "VAL_BLK", "address": "0x3900", "deposit": "RL_COMPLEX",
         "compu": "CM_IDENT", "upper": 65535, "matrix_dim": [4]}
      ],
      "typedef_measurements": [
        {"name": "TM_VOLTAGE", "desc": "STRUCTURE_COMPONENT 引用的 typedef",
         "datatype": "UWORD", "compu": "CM_IDENT"}
      ],
      "typedef_structures": [
        {"name": "ST_ENGINE", "desc": "引擎状态块（成员不展开）", "size": 6,
         "members": [
           {"name": "u_rpm", "typedef": "TM_VOLTAGE", "offset": 0},
           {"name": "u_flag", "typedef": "TM_VOLTAGE", "offset": 2,
            "matrix_dim": [2]}
         ]},
        {"name": "ST_WRAPPER", "desc": "引用 ST_ENGINE（不递归展开）", "size": 8,
         "members": [
           {"name": "inner", "typedef": "ST_ENGINE", "offset": 0}
         ]}
      ],
      "instances": [
        {"name": "I_ENGINE", "desc": "INSTANCE 元数据",
         "ref_typedef": "ST_ENGINE", "address": "0x3600", "read_write": true,
         "ext": "0x12"}
      ],
      "if_data": [
        {
          "protocol": "XCP",
          "protocol_layer": {"version": "0x100", "max_cto": "0x10",
                             "max_dto": "0x20"},
          "udp": {"port": "0x15B9", "host": "localhost",
                  "packet_alignment": "PACKET_ALIGNMENT_32",
                  "sub_commands": ["GET_SLAVE_ID", "SET_SLAVE_IP_ADDRESS"]},
          "daq": {
            "type": "STATIC", "max_daq": 4, "max_event": 2, "min_daq": 1,
            "overload": "NO_OVERLOAD_INDICATION",
            "events": [
              {"name": "ev_read", "short": "evr", "number": 1,
               "type": "DAQ", "max_daq_list": 2, "time_cycle": 10,
               "time_unit": 4, "priority": 2}
            ],
            "daq_list": {
              "number": 2, "odt_number": 1, "type": "DAQ",
              "max_odt": 2, "max_odt_entries": 3, "first_pid": 4,
              "event_fixed": 1,
              "entries": [
                {"number": 1, "address": "0x3000", "ext": "0x0", "size": 2,
                 "bit_offset": 0},
                {"number": 2, "address": "0x3020", "ext": "0x0", "size": 1,
                 "bit_offset": 3},
                {"number": 3, "address": "0x3010", "ext": "0x12", "size": 12,
                 "bit_offset": 0}
              ]
            }
          }
        }
      ]
    }
  ]
}
