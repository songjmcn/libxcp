{
  "project": "XcpPlusProj",
  "project_desc": "XCP vs XCPplus priority + conflict report (S6.3-A)",
  "modules": [
    {
      "name": "PLUS_ECU",
      "comment": "both IF_DATA protocols present, XCPplus wins",
      "mod_common": true,
      "mod_par": false,
      "compu_methods": [{"name": "CM_IDENT", "type": "IDENTICAL"}],
      "measurements": [
        {"name": "M_PLUS", "desc": "symbol of plus module", "datatype": "UWORD",
         "compu": "CM_IDENT", "address": "0x6000", "ext": "0x0"}
      ],
      "if_data": [
        {
          "protocol": "XCP",
          "protocol_layer": {"version": "0x100", "max_cto": "0x10",
